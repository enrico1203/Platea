# Copia in .env e modifica se serve.
# Una cartella dei media (vista come /media). Per più cartelle aggiungi righe nei volumes del compose.
MEDIA_DIR=/mnt/media
PLATEA_SERVER_PORT=8096
PLATEA_WEB_PORT=8080
PLATEA_LOG=info
TZ=Europe/Rome

# Tunnel Cloudflare (facoltativo): il token del tunnel e il profilo che avvia cloudflared.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
